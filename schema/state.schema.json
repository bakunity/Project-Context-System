{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bakunity/Project-Context-System/schema/state.schema.json",
  "title": "Project Context System state",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project",
    "state_doc",
    "architecture_doc",
    "roadmap_doc",
    "adr_dir",
    "state_based_on_commit",
    "status",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project": {"type": "string", "minLength": 1},
    "state_doc": {"type": "string", "minLength": 1},
    "active_work_doc": {"type": ["string", "null"]},
    "architecture_doc": {"type": "string", "minLength": 1},
    "roadmap_doc": {"type": "string", "minLength": 1},
    "adr_dir": {"type": "string", "minLength": 1},
    "incidents_dir": {"type": ["string", "null"]},
    "evidence_doc": {"type": ["string", "null"]},
    "state_based_on_commit": {"type": "string", "minLength": 7},
    "last_verified_commit": {"type": ["string", "null"]},
    "active_branch": {"type": ["string", "null"]},
    "active_pr": {"type": ["integer", "null"]},
    "status": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date"}
  }
}
